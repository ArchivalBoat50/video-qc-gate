{
  "id": "videoQCnative1",
  "name": "Video QC Loop (MVP - native n8n)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "trig",
      "name": "Every hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -420,
        300
      ]
    },
    {
      "parameters": {},
      "id": "manual",
      "name": "Run now",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -420,
        120
      ]
    },
    {
      "parameters": {
        "command": "PIPE_DATA=/ABSOLUTE/PATH/TO/video-qc-gate/data python3 /ABSOLUTE/PATH/TO/video-qc-gate/scripts/scan.py",
        "executeOnce": true
      },
      "id": "scan",
      "name": "ffmpeg pre-QC",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        -200,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.stdout || '[]';\nlet clips = [];\ntry { clips = JSON.parse(raw); } catch (e) { throw new Error('scan.py did not return JSON: ' + raw.slice(0,300)); }\nif (!clips.length) return [];\n\n// Everything below is interpolated into a shell command by the move nodes, and\n// the model controls part of it (defects/note). Strip shell metacharacters and\n// newlines so a reply like '\"; rm -rf /data; #' cannot execute. Also caps the\n// length so one rambling note cannot blow out the command line.\nconst shellSafe = (s) => String(s == null ? '' : s)\n  .replace(/[\\r\\n\\t]+/g, ' ')\n  .replace(/[\"'`$\\\\;&|<>]/g, '')\n  .replace(/\\s+/g, ' ')\n  .trim()\n  .slice(0, 200) || 'no detail';\n\nreturn clips.map(c => ({ json: {\n  ...c,\n  safe_reason: shellSafe((c.hard_fail_reasons || []).join('; ')),\n} }));"
      },
      "id": "split",
      "name": "One item per clip",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        20,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.hard_fail }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "ifhard",
      "name": "Hard fail?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "command": "=PIPE_DATA=/ABSOLUTE/PATH/TO/video-qc-gate/data sh /ABSOLUTE/PATH/TO/video-qc-gate/scripts/move.sh \"{{ $json.path }}\" rejected \"{{ $json.safe_reason }}\"",
        "executeOnce": false
      },
      "id": "rej1",
      "name": "Reject (objective)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        480,
        160
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-goog-api-key",
              "value": "={{ $env.GEMINI_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [ { parts: [ { text: $('Load rubric').first().json.rubric }, { inline_data: { mime_type: 'image/jpeg', data: $json.sheet_b64 } } ] } ], generationConfig: { temperature: 0, responseMimeType: 'application/json' } }) }}",
        "options": {
          "timeout": 120000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 5000
            }
          }
        }
      },
      "id": "gem",
      "name": "Gemini QC",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        420
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 10000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const fs = require('fs');\nconst rubric = fs.readFileSync('/ABSOLUTE/PATH/TO/video-qc-gate/scripts/gemini_rubric.txt','utf8');\nreturn [{ json: { rubric } }];"
      },
      "id": "rub",
      "name": "Load rubric",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -200,
        480
      ]
    },
    {
      "parameters": {
        "jsCode": "// Runs once per item. Must stay in runOnceForEachItem mode: this body uses\n// $json and $('Hard fail?').item, which are single-item constructs. In the\n// default run-once-for-all-items mode it silently collapsed N Gemini replies\n// into 1 and dropped every clip after the first.\nconst clip = $('Hard fail?').item.json;\nlet verdict = { verdict: 'review', confidence: 0, defects: [], note: 'unparseable model reply' };\n\n// The Gemini node continues on error so one bad clip cannot strand the batch.\n// A failed call arrives here as an error item; route it to review rather than\n// silently rejecting a clip nobody actually looked at.\nif ($json.error) {\n  const msg = typeof $json.error === 'string' ? $json.error : ($json.error.message || JSON.stringify($json.error));\n  // n8n wraps the upstream body as \"400 - {json}\"; pull out just the message\n  // so the log line is readable instead of a mashed JSON blob.\n  const m = String(msg).match(/\"message\"\\s*:\\s*\"((?:[^\"\\\\]|\\\\.)*)\"/);\n  verdict = { verdict: 'review', confidence: 0, defects: [], note: 'gemini call failed: ' + (m ? m[1] : String(msg)) };\n} else {\n  try {\n    verdict = JSON.parse($json.candidates[0].content.parts[0].text);\n  } catch (e) {}\n}\nif (!Array.isArray(verdict.defects)) verdict.defects = verdict.defects ? [String(verdict.defects)] : [];\nif (typeof verdict.verdict !== 'string') verdict.verdict = 'review';\nif (!['pass','review','fail'].includes(verdict.verdict)) verdict.verdict = 'review';\n\n// Everything below is interpolated into a shell command by the move nodes, and\n// the model controls part of it (defects/note). Strip shell metacharacters and\n// newlines so a reply like '\"; rm -rf /data; #' cannot execute. Also caps the\n// length so one rambling note cannot blow out the command line.\nconst shellSafe = (s) => String(s == null ? '' : s)\n  .replace(/[\\r\\n\\t]+/g, ' ')\n  .replace(/[\"'`$\\\\;&|<>]/g, '')\n  .replace(/\\s+/g, ' ')\n  .trim()\n  .slice(0, 200) || 'no detail';\n\nconst detail = verdict.defects.length ? verdict.defects.join('; ') : (verdict.note || '');\nreturn { json: {\n  ...clip,\n  sheet_b64: undefined,\n  ...verdict,\n  safe_reason: shellSafe(verdict.verdict + ': ' + detail),\n} };",
        "mode": "runOnceForEachItem"
      },
      "id": "parse",
      "name": "Parse verdict",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        420
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.verdict }}",
              "rightValue": "pass",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "ifpass",
      "name": "Passed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        920,
        420
      ]
    },
    {
      "parameters": {
        "command": "=PIPE_DATA=/ABSOLUTE/PATH/TO/video-qc-gate/data sh /ABSOLUTE/PATH/TO/video-qc-gate/scripts/move.sh \"{{ $json.path }}\" approved \"gemini pass conf={{ $json.confidence }}\"",
        "executeOnce": false
      },
      "id": "app",
      "name": "Approve",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        1160,
        320
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "command": "=PIPE_DATA=/ABSOLUTE/PATH/TO/video-qc-gate/data sh /ABSOLUTE/PATH/TO/video-qc-gate/scripts/move.sh \"{{ $json.path }}\" rejected \"{{ $json.safe_reason }}\"",
        "executeOnce": false
      },
      "id": "rej2",
      "name": "Reject (model)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        1400,
        720
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.verdict }}",
              "rightValue": "review",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "ifreview",
      "name": "Needs review?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1160,
        620
      ]
    },
    {
      "parameters": {
        "executeOnce": false,
        "command": "=PIPE_DATA=/ABSOLUTE/PATH/TO/video-qc-gate/data sh /ABSOLUTE/PATH/TO/video-qc-gate/scripts/move.sh \"{{ $json.path }}\" review \"{{ $json.safe_reason }}\""
      },
      "id": "rev",
      "name": "Send to review",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        1400,
        540
      ],
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Every hour": {
      "main": [
        [
          {
            "node": "Load rubric",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "ffmpeg pre-QC": {
      "main": [
        [
          {
            "node": "One item per clip",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "One item per clip": {
      "main": [
        [
          {
            "node": "Hard fail?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Hard fail?": {
      "main": [
        [
          {
            "node": "Reject (objective)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Gemini QC",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gemini QC": {
      "main": [
        [
          {
            "node": "Parse verdict",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse verdict": {
      "main": [
        [
          {
            "node": "Passed?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Passed?": {
      "main": [
        [
          {
            "node": "Approve",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Needs review?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Needs review?": {
      "main": [
        [
          {
            "node": "Send to review",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Reject (model)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run now": {
      "main": [
        [
          {
            "node": "Load rubric",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Load rubric": {
      "main": [
        [
          {
            "node": "ffmpeg pre-QC",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
